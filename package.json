{
  "name": "cctp-v1-status",
  "version": "0.1.0",
  "description": "Read-only status page and API for CCTP V1 limits and route health between Noble and Ethereum",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "snapshot": "tsx scripts/snapshot-once.ts",
    "verify": "tsx scripts/verify-mainnet.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "api": "tsx src/index.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "chart.js": "^4.6.1",
    "hono": "^4.13.16",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}
