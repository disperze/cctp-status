# Used by `npm run snapshot` (the GitHub Action) and `npm run api`.
# In GitHub, set these as repository Variables (or Secrets for keyed RPC URLs).
ETH_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org,https://1rpc.io/eth
NOBLE_LCD_URLS=https://noble-api.polkachu.com,https://api.noble.xyz,https://rest.cosmos.directory/noble
# Osmosis allUSDC pool 3497 liquidity (calculator). Must allow CosmWasm smart queries.
OSMOSIS_LCD_URLS=https://osmosis-api.polkachu.com,https://osmosis-rest.publicnode.com,https://rest.cosmos.directory/osmosis

SAFETY_MARGIN=0.998
ALLOWANCE_WARN_USDC=5000000
TREND_WINDOW_HOURS=24
REQUEST_TIMEOUT_MS=8000

# Where snapshot/burn JSON is written (the `data` branch in GitHub)
DATA_DIR=data
HISTORY_PUBLISH_DAYS=30
BURNS_BACKFILL_DAYS=7
BURNS_MAX_PAGES=20

# Optional alerts on limit changes / route state flips
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Browser build (npm run build / npm run dev). These end up in public JS: no secrets.
# VITE_DATA_URL=https://raw.githubusercontent.com/<owner>/<repo>/data   (default in dev: /data from DATA_DIR)
# VITE_ETH_RPC_URLS=
# VITE_NOBLE_LCD_URLS=
# VITE_OSMOSIS_LCD_URLS=
# VITE_POLL_SEC=60
